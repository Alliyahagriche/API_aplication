<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/LoginFragment">

    <fragment
        android:id="@+id/LoginFragment"
        android:name="com.example.myapplication.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_LoginFragment_to_FirstFragment"
            app:destination="@id/FirstFragment"
            app:popUpTo="@id/LoginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.myapplication.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">
        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_ApiFragment"
            app:destination="@id/ApiFragment" />
    </fragment>

    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.myapplication.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">
        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
        <action
            android:id="@+id/action_SecondFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />
    </fragment>

    <fragment
        android:id="@+id/ThirdFragment"
        android:name="com.example.myapplication.ThirdFragment"
        android:label="Third Fragment"
        tools:layout="@layout/fragment_third_3">
        <action
            android:id="@+id/action_ThirdFragment_to_FourthFragment"
            app:destination="@id/FourthFragment" />
    </fragment>

    <fragment
        android:id="@+id/FourthFragment"
        android:name="com.example.myapplication.FourthFragment"
        android:label="Fourth Fragment"
        tools:layout="@layout/fragment_fourth">
        <action
            android:id="@+id/action_FourthFragment_to_FiveFragment"
            app:destination="@id/FiveFragment" />
    </fragment>

    <fragment
        android:id="@+id/FiveFragment"
        android:name="com.example.myapplication.FiveFragment"
        android:label="Five Fragment"
        tools:layout="@layout/fragment_five">
        <action
            android:id="@+id/action_FiveFragment_to_SixthFragment"
            app:destination="@id/SixthFragment" />
    </fragment>

    <fragment
        android:id="@+id/SixthFragment"
        android:name="com.example.myapplication.SixthFragment"
        android:label="Sixth Fragment"
        tools:layout="@layout/fragment_sixth">
        <action
            android:id="@+id/action_SixthFragment_to_FirstFragment"
            app:destination="@id/FirstFragment"
            app:popUpTo="@id/FirstFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/DatabaseFragment"
        android:name="com.example.myapplication.DatabaseFragment"
        android:label="Database Fragment"
        tools:layout="@layout/fragment_api" />

    <fragment
        android:id="@+id/ApiFragment"
        android:name="com.example.myapplication.ApiFragment"
        android:label="API Fragment"
        tools:layout="@layout/fragment_api">
        <action
            android:id="@+id/action_ApiFragment_to_DetailFragment"
            app:destination="@id/DetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/DetailFragment"
        android:name="com.example.myapplication.DetailFragment"
        android:label="Detail Fragment"
        tools:layout="@layout/fragment_detail" />

</navigation>
